# Local : `pnpm db:start` puis copier les valeurs affichées (ou voir .env.local,
# déjà rempli avec les clés de démo fixes de la CLI Supabase).
#
# Preview/prod (projet Supabase partagé "hybrideclub", eu-west-1 — voir
# 00-brief-site-hybride.md et docs/adr/ADR-001-*.md) : à configurer par `devops`
# en variables d'environnement Vercel, jamais commité ici.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=

# E-mail transactionnel du club (ADR-006, prestataire amendé par ADR-009 : Resend,
# distinct du Brevo de l'app). RESEND_FROM porte le nom affiché et l'adresse
# d'expédition ensemble ("Nom <adresse@domaine>"). Les e-mails de compte (création,
# mot de passe oublié) ne passent pas par ces variables : ils partent du SMTP
# Brevo configuré côté Supabase Auth (ADR-006 §2), réglage partagé avec l'app,
# inchangé par ce changement de prestataire.
RESEND_API_KEY=
RESEND_FROM=
CRON_SECRET=
PROOF_IP_SALT=
